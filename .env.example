# Copy this file to `.env` and fill in your key. `.env` is gitignored — never commit it.
# The web app loads `.env` automatically on startup.

# Required for the agent (Gemini is the default provider):
GEMINI_API_KEY=

# Optional — overrides the default model (gemini-3.1-flash-lite):
# GEMINI_MODEL=gemini-2.5-flash

# Optional — only if you want to use Anthropic instead of Gemini:
# ANTHROPIC_API_KEY=
